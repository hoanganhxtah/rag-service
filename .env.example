# RAG Service only. Relative data paths are resolved from this directory,
# regardless of the process working directory.

# HTTP server
RAG_SERVICE_HOST=127.0.0.1
RAG_SERVICE_PORT=8002
RAG_SERVICE_RELOAD=true
RAG_SERVICE_LOG_LEVEL=INFO
RAG_SERVICE_CONTEXT_PATH=/api/v1

# Vector store
RAG_COLLECTION_NAME=InternalDocDB_bge_m3_v1
# Non-empty URL selects Qdrant server mode and ignores RAG_QDRANT_PATH.
RAG_QDRANT_URL=
RAG_QDRANT_PATH=data/runtime/qdrant
RAG_NUM_RETRIEVAL=5

# Embeddings
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL_NAME=data/models/bge-m3
RAG_EMBEDDING_OUTPUT_DIMENSION=1024
RAG_EMBEDDING_MAX_SEQ_LENGTH=768
RAG_EMBEDDING_BATCH_SIZE=1
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_ALLOW_HF_DOWNLOAD=false
# Required only when RAG_EMBEDDING_PROVIDER=gemini.
GEMINI_API_KEY=

# Ingestion
RAG_INGEST_DATA_FOLDER=data/raw
RAG_INGEST_CHUNK_SIZE=600
RAG_INGEST_CHUNK_OVERLAP=80

# AWS S3 Settings
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=raw-rag-data
S3_REGION=ap-south-1
